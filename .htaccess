# RN Psikoloji Çayyolu – statik site (Apache / cPanel)
Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html
AddDefaultCharset UTF-8
AddType image/webp .webp
AddType image/svg+xml .svg

<IfModule mod_rewrite.c>
RewriteEngine On

# HTTPS + www
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} !^www\. [NC]
RewriteRule ^(.*)$ https://www.cayyolupsikolog.com.tr/$1 [R=301,L]

# Kaynak klasörü dışarı kapalı
RewriteRule ^_kaynak(/|$) - [F,L]
RewriteRule ^\.git(/|$) - [F,L]
RewriteRule ^\.ftp-deploy-sync-state\.json$ - [F,L]

# Eski WordPress adresleri
RewriteRule ^elementor-hf(/.*)?$ / [R=301,L]
RewriteRule ^author(/.*)?$ /hakkimizda/ [R=301,L]
RewriteRule ^category/uncategorized/?$ /blog/ [R=301,L]
RewriteRule ^(.+/)?feed/?$ /blog/ [R=301,L]
RewriteRule ^wp-json(/.*)?$ / [R=301,L]
RewriteRule ^ankara-psikolog/?$ https://www.psikologrojinnazik.com/ [R=301,L]
RewriteRule ^cayyolu-psikolog/?$ / [R=301,L]
RewriteRule ^psikolog-hazal-aksahin/?$ /uzmanlarimiz/ [R=301,L]
RewriteRule ^ankara-psikolog-tavsiyesi-2025-cayyolu-ve-yakin-bolgelerde-guvenilir-terapi-hizmeti/?$ https://www.psikologrojinnazik.com/ankara-psikolog-tavsiyesi/ [R=301,L]
RewriteRule ^wp-login\.php$ / [R=301,L]
RewriteRule ^wp-admin(/.*)?$ / [R=301,L]
RewriteRule ^(wp-)?sitemap(_index)?\.xml$ /sitemap.xml [R=301,L]
RewriteRule ^(page|post|category)-sitemap\.xml$ /sitemap.xml [R=301,L]
RewriteRule ^iletisim-2/?$ /iletisim/ [R=301,L]

# Kaldırılan çeviri yazılar -> özgün makaleler
RewriteRule ^aa-copy/?$ /cocuklarda-kaygi-ebeveyn-rehberi/ [R=301,L]
RewriteRule ^cocuklar-kayiplar-sonucu-buyuyebilir-mi/?$ /cocuklarda-yas-ve-kayip/ [R=301,L]
RewriteRule ^iliskilerde-buyumeye-odaklanin/?$ /evlilikte-iletisim-sorunlari/ [R=301,L]
RewriteRule ^kafamin-icindeki-muazzam-dunya/?$ /yalnizlik-hissi-ve-sosyal-geri-cekilme/ [R=301,L]
RewriteRule ^toksik-yonetimi-anlamak-ve-onlemek/?$ /is-stresi-ve-tukenmislik/ [R=301,L]
RewriteRule ^travmatik-stres/?$ /travma-sonrasi-stres-belirtileri/ [R=301,L]
RewriteRule ^yogun-psikoterapi/?$ /ilk-terapi-seansi-rehberi/ [R=301,L]

# ?p=123 ve ?page_id=123 gibi eski kısa adresler ana sayfaya
RewriteCond %{QUERY_STRING} (^|&)(p|page_id)=\d+ [NC]
RewriteRule ^$ /? [R=301,L]

# Sonda eğik çizgi (klasör adresleri)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_URI} !(\.[a-zA-Z0-9]{1,5}|/)$
RewriteCond %{DOCUMENT_ROOT}%{REQUEST_URI}/index.html -f
RewriteRule ^(.*)$ /$1/ [R=301,L]
</IfModule>

<IfModule mod_headers.c>
Header always set X-Content-Type-Options "nosniff"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
Header always set X-Frame-Options "SAMEORIGIN"
<FilesMatch "\.(css|js|webp|jpe?g|png|svg|woff2?)$">
Header set Cache-Control "public, max-age=31536000"
</FilesMatch>
<FilesMatch "\.(html|xml|txt)$">
Header set Cache-Control "public, max-age=600"
</FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
AddOutputFilterByType DEFLATE text/html text/css application/javascript text/javascript application/json image/svg+xml text/xml application/xml text/plain
</IfModule>
